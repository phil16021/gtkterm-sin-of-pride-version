<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>at.philipp.GtkTermSunshine</id>
  <name>GTKTerm Sunshine</name>
  <summary>Serial terminal with live data plots and an MCP server</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="at.philipp">
    <name>Philipp</name>
  </developer>
  <description>
    <p>A terminal for serial ports, TCP and UDP. Lines in the Sunshine format such as
      {temp|Inside|21.5} are plotted live as line, bar, pie or scatter charts. A built-in
      Model Context Protocol server lets AI agents read and drive connected devices.</p>
  </description>
  <launchable type="desktop-id">at.philipp.GtkTermSunshine.desktop</launchable>
  <provides>
    <mediatype>text/x-gtkterm-script</mediatype>
  </provides>
